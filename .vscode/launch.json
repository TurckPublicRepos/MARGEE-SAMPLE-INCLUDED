  "version": "0.2.0",
  "compounds": [
    {
      "name": "RUNTIME & HMI",
      "configurations": ["RUNTIME", "HMI (attach)"]
    }
  ],
  "configurations": [
    {
      "name": "RUNTIME",
      "type": "MARGEE",
      "request": "launch",
      "RefreshInterval": 250,
    }, 
    {
      "name": "HMI",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${config:MARGEE.Port}",
      "preLaunchTask": "Start MARGEE Live Preview",
      "postDebugTask": "Stop MARGEE Live Preview",
    },
    {
      "name": "HMI (attach)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${config:MARGEE.Port}",
      "preLaunchTask": "Start MARGEE Live Preview (attach)",
      "postDebugTask": "Stop MARGEE Live Preview",
      "presentation": {
        "hidden": true, 
      },
    },
  ],
}
