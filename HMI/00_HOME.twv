HMI_SCREEN("🏡 Home") 
  HMI_GRID("25px min-content 25px 1fr 25px 300px 25px", "25px min-content 1fr")
    HMI_CONTAINER(2, 1, 2, 1)
      HMI_TEXT_H1("MARGEE <strong>Sample</strong> Program"); 
    ;
    HMI_CONTAINER(2, 1, 3, 1)
      HMI_IMAGE("src.png");
    ;  
    HMI_CONTAINER(4, 1, 3, 1) 
      HMI_DISPLAY_VALUE(reg1, "We can display values: ", "cm", 10);
      HMI_INPUT_BUTTON(toggleExecute, "We can also have buttons!<br>Clicking this will set <code>toggleExecute</code>.")<margin-top-large>;
      HMI_TEXT_P("Or have numerical inputs, like below: ")<margin-top-large>; 
      HMI_INPUT_NUMBER(circumferenceTask.radius, "Radius = "); 
      HMI_DISPLAY_VALUE(circumferenceTask.circumference, "Circumference = " "");  
      HMI_TEXT_H3("Ethernet parameters ")<margin-top-large>;
      HMI_DISPLAY_GOM_VERSION(983041, 0, "IP: ", "")<code margin-left-large>;
      HMI_DISPLAY_GOM_VERSION(983042, 0, "NM: ", "")<code margin-left-large>;  
      HMI_DISPLAY_GOM_VERSION(983043, 0, "GW: ", "")<code margin-left-large>;
      HMI_DISPLAY_GOM_MAC(983044, 0, "MAC: " "")<code margin-left-large>;
    ;
    HMI_CONTAINER(6, 1, 2, 2)
      HMI_TEXT_H3("We can display gauges!")<text-align-center>;
      HMI_GAUGE_CIRCLE("register 1", reg1, 0, 4294967295);
      HMI_GAUGE_CIRCLE("register 2", reg2, 0, 65535); 
      HMI_GAUGE_BAR("register 3", reg3, -32768, 32767);
    ; 
  ;
;
